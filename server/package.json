{
  "name": "cr-locations-graphql-server",
  "version": "1.0.0",
  "description": "GraphQL API for Costa Rica's provincias, cantones, and distritos",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "tsc && cp schema.graphql dist/schema.graphql && mkdir -p dist/data && cp ../data/locations.json dist/data/locations.json",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "graphql": "^16.9.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
